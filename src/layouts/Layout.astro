---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Starfield from '../components/Starfield.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '周大牛的数字花园',
  description = '一个记录写作、摄影与生活的个人空间',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <!-- 页面渲染前恢复主题，避免闪白（必须内联同步执行） -->
    <script is:inline>
      document.documentElement.dataset.theme =
        localStorage.getItem('theme') === 'light' ? 'light' : 'dark';
    </script>
  </head>
  <body id="top">
    <Starfield />
    <div class="cursor-glow" id="cursor-glow" aria-hidden="true"></div>

    <!-- 独立的昼夜模式切换按钮：固定在页面左上角 -->
    <button
      id="theme-toggle"
      class="theme-toggle-float fixed left-3 top-3 z-50 flex h-11 w-11 items-center justify-center rounded-full border border-white/10 bg-black/20 text-zinc-400 backdrop-blur-md transition-all duration-300 hover:rotate-12 hover:border-cyan-400/50 hover:text-cyan-300"
      aria-label="切换昼夜模式"
      title="切换昼夜模式"
    >
      <svg class="theme-icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M20 13.5A8.5 8.5 0 0 1 10.5 4a8.5 8.5 0 1 0 9.5 9.5Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
      <svg class="theme-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m9.4 9.4 1.4 1.4m0-14.2-1.4 1.4M6.3 15.7l-1.4 1.4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
    <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>
    <Navbar />
    <main class="page-enter">
      <slot />
    </main>
    <Footer />

    <script>
      // 顶部滚动进度条
      const progress = document.getElementById('scroll-progress')!;

      // 昼夜模式切换（图标显隐由 CSS 控制）
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
        window.dispatchEvent(new CustomEvent('theme-change', { detail: next }));
      });
      const updateProgress = () => {
        const h = document.documentElement;
        const max = h.scrollHeight - h.clientHeight || 1;
        progress.style.width = `${Math.min((h.scrollTop / max) * 100, 100)}%`;
      };
      document.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();

      // 滚动渐显动画
      // 注意：threshold 必须为 0 —— 长文章的单个容器可能高达数万像素，
      // 屏幕只能显示其百分之几，若阈值 >0 会永远无法触发导致正文不可见
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('visible');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // 仅在支持鼠标悬浮的设备上启用增强效果
      const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      if (finePointer) {
        // 卡片 3D 倾斜
        document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
          const strength = Number(card.dataset.tilt) || 8;
          card.addEventListener('mousemove', (ev) => {
            const r = card.getBoundingClientRect();
            const x = (ev.clientX - r.left) / r.width - 0.5;
            const y = (ev.clientY - r.top) / r.height - 0.5;
            card.style.transform = `perspective(900px) rotateY(${x * strength}deg) rotateX(${-y * strength}deg) translateY(-4px)`;
          });
          card.addEventListener('mouseleave', () => {
            card.style.transform = '';
          });
        });

        // 光标光晕跟随（带缓动）
        const glow = document.getElementById('cursor-glow')!;
        let tx = window.innerWidth / 2;
        let ty = window.innerHeight / 2;
        let x = tx;
        let y = ty;
        window.addEventListener('mousemove', (e) => {
          tx = e.clientX;
          ty = e.clientY;
        });
        const loop = () => {
          x += (tx - x) * 0.08;
          y += (ty - y) * 0.08;
          glow.style.transform = `translate3d(${x - 250}px, ${y - 250}px, 0)`;
          requestAnimationFrame(loop);
        };
        loop();
      }
    </script>
  </body>
</html>
