---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout title="博客 | 周大牛的数字花园" description="写作与思考的存档">
  <section class="mx-auto max-w-4xl px-6 pb-28 pt-36">
    <p class="reveal text-sm font-semibold tracking-[0.3em] text-cyan-300">BLOG</p>
    <h1 class="reveal mt-3 font-serif text-4xl font-bold text-white md:text-5xl" style="--d:.05s">
      写作<span class="text-gradient">与思考</span>
    </h1>
    <p class="reveal mt-4 text-zinc-400" style="--d:.1s">把碎片整理成文章，把想法打磨成观点。</p>

    <div class="mt-14 space-y-5">
      {
        posts.map((post, i) => (
          <a
            href={`/blog/${post.id}/`}
            class="reveal glass group block rounded-2xl p-6 transition-all duration-300 hover:border-white/20 hover:bg-white/[0.06] md:p-8"
            style={`--d:${i * 0.08}s`}
          >
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="font-mono text-xs text-zinc-500">{fmt(post.data.pubDate)}</p>
                <h2 class="mt-2 font-serif text-xl font-bold text-white transition-colors duration-300 group-hover:text-cyan-300">
                  {post.data.title}
                </h2>
                <p class="mt-2 text-sm leading-relaxed text-zinc-400">{post.data.description}</p>
                <div class="mt-4 flex flex-wrap gap-2">
                  {post.data.tags.map((t) => (
                    <span class="tag">{t}</span>
                  ))}
                </div>
              </div>
              <span class="mt-1 shrink-0 text-lg text-zinc-600 transition-all duration-300 group-hover:translate-x-1 group-hover:text-cyan-300">
                →
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
