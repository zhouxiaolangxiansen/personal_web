---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// 目录只取二级、三级标题
const toc = (headings ?? []).filter((h) => h.depth >= 2 && h.depth <= 3);

// 文章完整链接（用于版权卡片与分享）
const postUrl = new URL(Astro.url.pathname, Astro.site).href;

// 字数与阅读时长统计（基于 Markdown 原文，剔除代码块和图片/链接地址）
const plain = (post.body ?? '')
  .replace(/```[\s\S]*?```/g, '')
  .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
  .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1');

const cjkCount = (plain.match(/[\u4e00-\u9fff]/g) ?? []).length;
const enWordCount = (plain.replace(/[\u4e00-\u9fff]/g, ' ').match(/[a-zA-Z0-9]+/g) ?? []).length;
const totalWords = cjkCount + enWordCount;

const wordCountText =
  totalWords >= 1000 ? `${(totalWords / 1000).toFixed(1)}k` : String(totalWords);

// 中文按约 400 字/分钟，英文按约 200 词/分钟
const readMinutes = Math.max(1, Math.round(cjkCount / 400 + enWordCount / 200));
---

<Layout title={`${post.data.title} | 周大牛的数字花园`} description={post.data.description}>
  <div class="mx-auto flex max-w-6xl gap-12 px-6 pb-28 pt-36">
    <!-- 左侧目录（桌面端） -->
    {
      toc.length > 0 && (
        <aside class="hidden w-56 shrink-0 lg:block">
          <div class="sticky top-28">
            <p class="text-xs font-semibold tracking-[0.25em] text-zinc-500">目录</p>
            <nav id="toc-nav" class="mt-4 space-y-0.5 border-l border-white/10">
              {toc.map((h) => (
                <a
                  href={`#${h.slug}`}
                  data-toc={h.slug}
                  class={`toc-link block truncate text-sm transition-all duration-300 ${
                    h.depth === 3 ? 'pl-8' : 'pl-4'
                  }`}
                  title={h.text}
                >
                  {h.text}
                </a>
              ))}
            </nav>
          </div>
        </aside>
      )
    }

    <!-- 文章主体（带阅读底板，隔离星空背景便于阅读） -->
    <article class="reading-card min-w-0 max-w-3xl flex-1">
      <a
        href="/blog"
        class="group inline-flex items-center gap-1.5 text-sm text-zinc-500 transition-colors hover:text-cyan-300"
      >
        <span class="transition-transform duration-300 group-hover:-translate-x-1">←</span>
        返回博客
      </a>

      <header class="mt-8">
        <div class="reveal flex flex-wrap items-center gap-2">
          {post.data.tags.map((t) => <span class="tag">{t}</span>)}
        </div>

        <!-- 发布日期 / 字数 / 阅读时长 -->
        <div class="reveal mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-zinc-500" style="--d:.1s">
          <span class="flex items-center gap-1.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="2"></rect><path d="M8 3v4M16 3v4M3 11h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
            发布日期：{post.data.pubDate.toISOString().slice(0, 10)}
          </span>
          <span class="flex items-center gap-1.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><rect x="5" y="3" width="14" height="18" rx="2" stroke="currentColor" stroke-width="2"></rect><path d="M9 8h6M9 12h6M9 16h4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
            文章字数：{wordCountText}
          </span>
          <span class="flex items-center gap-1.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"></circle><path d="M12 7v5l3 3" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
            阅读时长：约 {readMinutes} 分
          </span>
        </div>

        <h1 class="reveal mt-5 font-serif text-3xl font-bold leading-snug text-white md:text-4xl" style="--d:.15s">
          {post.data.title}
        </h1>
        <p class="reveal mt-4 leading-relaxed text-zinc-400" style="--d:.2s">{post.data.description}</p>
      </header>

      {
        post.data.cover && (
          <div class="reveal mt-10 overflow-hidden rounded-2xl border border-white/10" style="--d:.2s">
            <img src={post.data.cover} alt={post.data.title} class="w-full object-cover" width="1024" height="683" />
          </div>
        )
      }

      <div class="prose-custom reveal mt-4" style="--d:.25s">
        <Content />
      </div>

      <!-- 版权声明卡片 -->
      <div class="reveal glass mt-14 rounded-2xl p-6 md:p-8" style="--d:.1s">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm leading-relaxed">
          <svg class="shrink-0 text-zinc-400" width="15" height="15" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="2"/><path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <span class="font-semibold text-zinc-300">文章作者：</span>
          <span class="text-cyan-300">{post.data.author}</span>
        </p>
        <p class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm leading-relaxed">
          <svg class="shrink-0 text-zinc-400" width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M10 14a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1.5 1.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M14 10a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7L12.5 18.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <span class="font-semibold text-zinc-300">文章链接：</span>
          <a href={postUrl} class="break-all text-cyan-300 underline-offset-4 hover:underline">{postUrl}</a>
        </p>
        <p class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm leading-relaxed">
          <svg class="shrink-0 text-zinc-400" width="15" height="15" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><path d="M15.5 9.5a4 4 0 1 0 0 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <span class="font-semibold text-zinc-300">版权声明：</span>
          <span class="text-zinc-400">本博客所有文章除特别声明外，均采用
            <a href="https://creativecommons.org/licenses/by/4.0/deed.zh" target="_blank" rel="noopener noreferrer" class="text-cyan-300 underline-offset-4 hover:underline">CC BY 4.0</a>
            许可协议。转载请注明来源 <span class="text-cyan-300">{post.data.author}</span> ！</span>
        </p>

        <!-- 分享 -->
        <div class="mt-5 flex items-center gap-3 border-t border-white/5 pt-5">
          <span class="text-xs text-zinc-500">分享到：</span>
          <a
            href={`https://service.weibo.com/share/share.php?url=${encodeURIComponent(postUrl)}&title=${encodeURIComponent(post.data.title)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-8 w-8 items-center justify-center rounded-full border border-white/10 text-zinc-400 transition-all duration-300 hover:scale-110 hover:border-rose-400/50 hover:text-rose-300"
            aria-label="分享到微博"
          >
            <span class="text-[10px] font-semibold">微博</span>
          </a>
          <a
            href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(postUrl)}&text=${encodeURIComponent(post.data.title)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-8 w-8 items-center justify-center rounded-full border border-white/10 text-zinc-400 transition-all duration-300 hover:scale-110 hover:border-sky-400/50 hover:text-sky-300"
            aria-label="分享到 X"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>
          </a>
          <button
            id="copy-link"
            class="flex h-8 items-center gap-1.5 rounded-full border border-white/10 px-3 text-xs text-zinc-400 transition-all duration-300 hover:border-cyan-400/50 hover:text-cyan-300"
            data-url={postUrl}
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><rect x="9" y="9" width="12" height="12" rx="2" stroke="currentColor" stroke-width="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" stroke="currentColor" stroke-width="2"/></svg>
            <span id="copy-link-text">复制链接</span>
          </button>
        </div>
      </div>

      <div class="mt-16 flex justify-center">
        <a href="/blog" class="btn-ghost">← 回到文章列表</a>
      </div>
    </article>
  </div>

  <script>
    // ===== 图片题注：把 img[alt] 包装成 figure + figcaption =====
    document.querySelectorAll<HTMLImageElement>('.prose-custom img').forEach((img) => {
      const alt = img.alt.trim();
      if (!alt) return;
      const figure = document.createElement('figure');
      const caption = document.createElement('figcaption');
      caption.textContent = alt;
      const parent = img.parentElement;
      // 图片通常独占一个段落，直接替换整个 <p>；否则只替换 img
      if (parent && parent.tagName === 'P' && parent.children.length === 1) {
        parent.replaceWith(figure);
      } else {
        img.replaceWith(figure);
      }
      figure.append(img, caption);
    });

    // ===== 目录滚动高亮（scroll-spy）=====
    const tocLinks = new Map<string, HTMLElement>();
    document.querySelectorAll<HTMLElement>('[data-toc]').forEach((a) => {
      const id = a.dataset.toc!;
      tocLinks.set(id, a);
    });

    const headings = [...document.querySelectorAll('h2[id], h3[id]')].filter((h) =>
      tocLinks.has(h.id)
    );

    if (headings.length > 0 && tocLinks.size > 0) {
      const setActive = (id: string) => {
        for (const [key, link] of tocLinks) {
          link.classList.toggle('toc-active', key === id);
        }
      };

      const spy = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) setActive(e.target.id);
          }
        },
        // 视口上沿往下 20% 处视为"当前阅读位置"
        { rootMargin: '0px 0px -80% 0px', threshold: 0 }
      );
      headings.forEach((h) => spy.observe(h));

      // 初始高亮第一个
      setActive(headings[0]!.id);
    }

    // ===== 复制文章链接 =====
    const copyBtn = document.getElementById('copy-link');
    copyBtn?.addEventListener('click', async () => {
      const textEl = document.getElementById('copy-link-text');
      try {
        await navigator.clipboard.writeText(copyBtn.dataset.url ?? window.location.href);
        if (textEl) {
          textEl.textContent = '已复制';
          setTimeout(() => (textEl.textContent = '复制链接'), 2000);
        }
      } catch {
        if (textEl) textEl.textContent = '复制失败';
      }
    });

    // ===== Mermaid 流程图渲染 =====
    // 注意：Astro/Shiki 渲染的代码块标识是 pre[data-language="mermaid"]，没有 language-mermaid 类
    import mermaid from 'mermaid';

    const blocks = document.querySelectorAll<HTMLElement>('pre[data-language="mermaid"]');
    if (blocks.length > 0) {
      mermaid.initialize({
        startOnLoad: false,
        theme: 'dark',
        themeVariables: {
          background: 'transparent',
          primaryColor: '#2a1a4a',
          primaryTextColor: '#fff',
          primaryBorderColor: '#8b5cf6',
          lineColor: '#22d3ee',
          secondaryColor: '#0e3a4a',
          tertiaryColor: '#3a1a2e',
        },
        fontFamily: 'PingFang SC, Hiragino Sans GB, Microsoft YaHei, sans-serif',
      });

      for (const el of blocks) {
        const source = el.querySelector('code')?.textContent ?? '';
        try {
          const { svg } = await mermaid.render(
            `mmd-${Math.random().toString(36).slice(2)}`,
            source
          );
          const box = document.createElement('div');
          box.className = 'mermaid-box';
          box.innerHTML = svg;
          el.replaceWith(box);
        } catch {
          // 渲染失败时保留原始代码块，不让文章崩掉
        }
      }
    }
  </script>
</Layout>
