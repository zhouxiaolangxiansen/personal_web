---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const photos = (await getCollection('photos')).sort(
  (a, b) => a.data.order - b.data.order
);

const videos = (await getCollection('videos')).sort(
  (a, b) => a.data.order - b.data.order
);

const categories = ['全部', ...new Set(photos.map((p) => p.data.category))];
---

<Layout title="影像 | 周大牛的数字花园" description="摄影与视频作品集">
  <section class="mx-auto max-w-6xl px-6 pb-28 pt-36">
    <p class="reveal text-sm font-semibold tracking-[0.3em] text-pink-400">GALLERY</p>
    <h1 class="reveal mt-3 font-serif text-4xl font-bold text-white md:text-5xl" style="--d:.05s">
      光影<span class="text-gradient">瞬间</span>
    </h1>
    <p class="reveal mt-4 text-zinc-400" style="--d:.1s">快门只是一瞬间，等待才是摄影的大部分。</p>

    <!-- 分类筛选 -->
    <div class="reveal mt-10 flex flex-wrap gap-3" style="--d:.15s">
      {
        categories.map((c, i) => (
          <button class={`chip ${i === 0 ? 'active' : ''}`} data-filter={c === '全部' ? 'all' : c}>
            {c}
          </button>
        ))
      }
    </div>

    <!-- 照片网格 -->
    <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        photos.map((p, i) => (
          <button
            class="reveal group relative block overflow-hidden rounded-2xl"
            data-photo={i}
            data-src={p.data.src}
            data-title={p.data.title}
            data-category={p.data.category}
            style={`--d:${(i % 3) * 0.08}s`}
            aria-label={`查看 ${p.data.title} 大图`}
          >
            <img
              src={p.data.src}
              alt={p.data.title}
              class="aspect-[3/2] w-full object-cover transition-transform duration-700 group-hover:scale-110"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100" />
            <div class="absolute inset-x-0 bottom-0 translate-y-3 p-5 text-left opacity-0 transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100">
              <p class="caption-title font-serif text-lg font-bold text-white">{p.data.title}</p>
              <p class="mt-1 text-xs text-zinc-400">{p.data.category} · 点击查看大图</p>
            </div>
          </button>
        ))
      }
    </div>

    <!-- 视频 -->
    <div class="mt-28">
      <p class="reveal text-sm font-semibold tracking-[0.3em] text-cyan-300">VIDEO</p>
      <h2 class="reveal mt-3 font-serif text-3xl font-bold text-white md:text-4xl" style="--d:.05s">
        视频作品
      </h2>

      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {
          videos.map((v, i) =>
            v.data.src ? (
              <div
                class="tilt-card reveal glass overflow-hidden rounded-2xl"
                data-tilt="5"
                style={`--d:${i * 0.08}s`}
              >
                <video
                  src={v.data.src}
                  poster={v.data.cover}
                  controls
                  preload="metadata"
                  class="aspect-video w-full bg-black"
                ></video>
                <div class="p-4">
                  <p class="font-serif text-sm font-bold text-white">{v.data.title}</p>
                  {v.data.description && <p class="mt-1 text-xs text-zinc-500">{v.data.description}</p>}
                </div>
              </div>
            ) : v.data.cover ? (
              <div
                class="tilt-card glass reveal group relative aspect-video overflow-hidden rounded-2xl"
                data-tilt="5"
                style={`--d:${i * 0.08}s`}
              >
                <img src={v.data.cover} alt={v.data.title} class="h-full w-full object-cover opacity-60" loading="lazy" />
                <div class="absolute inset-0 flex items-center justify-center">
                  <div
                    class="flex h-16 w-16 items-center justify-center rounded-full border border-white/30 bg-black/40 backdrop-blur transition-transform duration-300 group-hover:scale-110"
                    style="animation: glow-pulse 3s ease-in-out infinite"
                  >
                    <div class="ml-1 h-0 w-0 border-y-8 border-l-[14px] border-y-transparent border-l-white"></div>
                  </div>
                </div>
                <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 to-transparent p-4">
                  <p class="font-serif text-sm font-bold text-white">{v.data.title}</p>
                  {v.data.description && <p class="mt-0.5 text-xs text-zinc-400">{v.data.description}</p>}
                </div>
              </div>
            ) : (
              <div
                class="reveal flex aspect-video flex-col items-center justify-center gap-3 rounded-2xl border border-dashed border-white/15 bg-white/[0.02]"
                style={`--d:${i * 0.08}s`}
              >
                <div class="flex h-12 w-12 items-center justify-center rounded-full border border-white/15 text-zinc-500">
                  +
                </div>
                <p class="text-xs text-zinc-600">{v.data.title}</p>
              </div>
            )
          )
        }
      </div>
    </div>
  </section>

  <!-- 灯箱 -->
  <div class="lightbox" id="lightbox" role="dialog" aria-label="图片查看器">
    <img id="lightbox-img" alt="" />
    <p id="lightbox-caption" class="mt-5 text-sm text-zinc-400"></p>
    <button class="lightbox-btn lightbox-close" id="lb-close" aria-label="关闭">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M2 2l12 12M14 2L2 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    </button>
    <button class="lightbox-btn lightbox-prev" id="lb-prev" aria-label="上一张">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M11.5 3L5.5 9l6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <button class="lightbox-btn lightbox-next" id="lb-next" aria-label="下一张">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M6.5 3l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>

  <script>
    // ===== 分类筛选 =====
    const chips = document.querySelectorAll<HTMLButtonElement>('.chip[data-filter]');
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chips.forEach((c) => c.classList.remove('active'));
        chip.classList.add('active');
        const cat = chip.dataset.filter!;
        document.querySelectorAll<HTMLElement>('[data-category]').forEach((card) => {
          const show = cat === 'all' || card.dataset.category === cat;
          card.style.display = show ? '' : 'none';
        });
      });
    });

    // ===== 灯箱 =====
    const cards = [...document.querySelectorAll<HTMLElement>('[data-photo]')];
    const lightbox = document.getElementById('lightbox')!;
    const lbImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const lbCaption = document.getElementById('lightbox-caption')!;

    let current = 0;

    const openLightbox = (i: number) => {
      current = (i + cards.length) % cards.length;
      const card = cards[current]!;
      lbImg.src = card.dataset.src ?? '';
      lbImg.alt = card.dataset.title ?? '';
      lbCaption.textContent = `${card.dataset.title}（${current + 1} / ${cards.length}）`;
      lightbox.classList.add('open');
      document.body.style.overflow = 'hidden';
    };

    const closeLightbox = () => {
      lightbox.classList.remove('open');
      document.body.style.overflow = '';
    };

    cards.forEach((card) => {
      card.addEventListener('click', () => openLightbox(Number(card.dataset.photo)));
    });

    document.getElementById('lb-close')?.addEventListener('click', closeLightbox);
    document.getElementById('lb-prev')?.addEventListener('click', () => openLightbox(current - 1));
    document.getElementById('lb-next')?.addEventListener('click', () => openLightbox(current + 1));

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('open')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') openLightbox(current - 1);
      if (e.key === 'ArrowRight') openLightbox(current + 1);
    });
  </script>
</Layout>
