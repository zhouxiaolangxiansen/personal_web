---
interface Props {
  slug: string;
}
const { slug } = Astro.props;
---

<section class="mt-12" id="comments">
  <div class="reveal glass rounded-2xl p-6 md:p-8" style="--d:.1s">
    <h2 class="flex items-center gap-2.5 font-serif text-xl font-bold text-white">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="text-cyan-300"><path d="M21 12a8 8 0 0 1-8 8H4l2.5-2.5A8 8 0 1 1 21 12Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><circle cx="9" cy="12" r="1" fill="currentColor"/><circle cx="13" cy="12" r="1" fill="currentColor"/><circle cx="17" cy="12" r="1" fill="currentColor"/></svg>
      评论
      <span id="cm-total" class="text-sm font-normal text-zinc-500"></span>
    </h2>

    <!-- 评论表单 -->
    <form id={`cm-form-${slug}`} class="cm-form mt-5" data-slug={slug}>
      <div class="flex flex-col gap-3">
        <input
          type="text"
          class="cm-name w-full rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-sm text-white placeholder-zinc-500 outline-none transition-colors focus:border-cyan-400/50"
          placeholder="你的名字（可留空）"
          maxlength="24"
        />
        <textarea
          class="cm-text w-full resize-y rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm leading-relaxed text-white placeholder-zinc-500 outline-none transition-colors focus:border-cyan-400/50"
          rows="3"
          maxlength="500"
          placeholder="写下你的评论…"
        ></textarea>
        <!-- 蜜罐：人类看不见，机器人会填 -->
        <input type="text" class="cm-honeypot hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex flex-wrap gap-1.5 cm-emojis">
            {['😊', '🎉', '🌸', '🍺', '📷', '👍'].map((e) => (
              <button type="button" class="emoji-btn text-lg transition-transform duration-200 hover:scale-125">{e}</button>
            ))}
          </div>
          <button type="submit" class="cm-submit btn-primary text-sm">发表评论</button>
        </div>
      </div>
    </form>

    <!-- 提示 -->
    <p class="cm-tip mt-3 hidden rounded-xl px-4 py-2.5 text-sm"></p>

    <!-- 评论列表 -->
    <div class="cm-list mt-8 space-y-3"></div>
    <p class="cm-empty mt-6 hidden text-center text-sm text-zinc-500">
      还没有评论，来说点什么吧～
    </p>
    <p class="cm-error mt-6 hidden text-center text-sm text-zinc-500">
      评论服务暂不可用，请稍后再试。
    </p>
  </div>
</section>

<style>
  .emoji-btn {
    padding: 0.25rem 0.4rem;
    border-radius: 0.5rem;
    border: 1px solid transparent;
  }
  .emoji-btn:hover {
    background: rgba(255, 255, 255, 0.06);
  }
  .cm-card {
    animation: cm-pop 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes cm-pop {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }
</style>

<script>
  // 页面上只有一篇文章一个评论区，直接按 class 查找
  const form = document.querySelector<HTMLFormElement>('.cm-form');
  const nameEl = form?.querySelector<HTMLInputElement>('.cm-name');
  const textEl = form?.querySelector<HTMLTextAreaElement>('.cm-text');
  const honeypotEl = form?.querySelector<HTMLInputElement>('.cm-honeypot');
  const listEl = form?.parentElement?.querySelector<HTMLElement>('.cm-list');
  const emptyEl = form?.parentElement?.querySelector<HTMLElement>('.cm-empty');
  const errorEl = form?.parentElement?.querySelector<HTMLElement>('.cm-error');
  const tipEl = form?.parentElement?.querySelector<HTMLElement>('.cm-tip');
  const totalEl = document.getElementById('cm-total');
  const submitBtn = form?.querySelector<HTMLButtonElement>('.cm-submit');

  if (form && nameEl && textEl && honeypotEl && listEl && emptyEl && errorEl && tipEl && submitBtn) {
    const slug = form.dataset.slug!;

    interface Cm {
      name: string;
      text: string;
      time: string;
    }

    const fmtTime = (iso: string) => {
      const d = new Date(iso);
      const diff = Date.now() - d.getTime();
      if (diff < 60_000) return '刚刚';
      if (diff < 3600_000) return `${Math.floor(diff / 60_000)} 分钟前`;
      if (diff < 86400_000) return `${Math.floor(diff / 3600_000)} 小时前`;
      return d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
    };

    const showTip = (msg: string, ok: boolean) => {
      tipEl.textContent = msg;
      tipEl.className = `cm-tip mt-3 rounded-xl border px-4 py-2.5 text-sm ${
        ok
          ? 'border-emerald-400/30 bg-emerald-400/10 text-emerald-300'
          : 'border-rose-400/30 bg-rose-400/10 text-rose-300'
      }`;
      setTimeout(() => tipEl.classList.add('hidden'), 3000);
    };

    const renderCard = (m: Cm, prepend = false) => {
      const card = document.createElement('div');
      card.className = 'cm-card rounded-xl border border-white/5 bg-white/[0.03] p-4';
      card.innerHTML = `
        <div class="flex items-center justify-between">
          <p class="cm-name font-serif text-sm font-bold text-cyan-300"></p>
          <p class="cm-time font-mono text-xs text-zinc-500"></p>
        </div>
        <p class="cm-text mt-1.5 whitespace-pre-wrap text-sm leading-relaxed text-zinc-300"></p>`;
      // textContent 写入，防 XSS
      card.querySelector('.cm-name')!.textContent = m.name;
      card.querySelector('.cm-time')!.textContent = fmtTime(m.time);
      card.querySelector('.cm-text')!.textContent = m.text;
      prepend ? listEl.prepend(card) : listEl.append(card);
    };

    const load = async () => {
      try {
        const res = await fetch(`/api/comments?slug=${encodeURIComponent(slug)}`);
        const data = (await res.json()) as { ok: boolean; comments?: Cm[] };
        if (!data.ok || !data.comments) throw new Error();
        errorEl.classList.add('hidden');
        if (totalEl) {
          totalEl.textContent = data.comments.length > 0 ? `（${data.comments.length}）` : '';
        }
        if (data.comments.length === 0) {
          emptyEl.classList.remove('hidden');
          return;
        }
        for (const m of data.comments) renderCard(m);
      } catch {
        errorEl.classList.remove('hidden');
      }
    };

    // 快捷表情插入
    form.querySelector('.cm-emojis')?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.emoji-btn');
      if (!btn) return;
      textEl.value += btn.textContent ?? '';
      textEl.focus();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const text = textEl.value.trim();
      if (text.length < 2) return showTip('评论太短啦', false);

      submitBtn.disabled = true;
      submitBtn.textContent = '发送中…';
      try {
        const res = await fetch(`/api/comments?slug=${encodeURIComponent(slug)}`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            name: nameEl.value.trim(),
            text,
            honeypot: honeypotEl.value,
          }),
        });
        const data = (await res.json()) as {
          ok: boolean;
          error?: string;
          comment?: Cm;
        };
        if (!data.ok || !data.comment) throw new Error(data.error || '发送失败');

        renderCard(data.comment, true);
        emptyEl.classList.add('hidden');
        errorEl.classList.add('hidden');
        textEl.value = '';
        if (totalEl) {
          const n = listEl.querySelectorAll('.cm-card').length;
          totalEl.textContent = `（${n}）`;
        }
        showTip('评论成功 ✦', true);
      } catch (err) {
        showTip((err as Error).message || '发送失败，请稍后再试', false);
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = '发表评论';
      }
    });

    load();
  }
</script>
