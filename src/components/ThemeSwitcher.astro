---
// 六种主题：图标 + 名称
const themes = [
  { id: 'dark', name: '黑夜', desc: '星空与流星' },
  { id: 'light', name: '白天', desc: '明亮纸感' },
  { id: 'morning', name: '早晨', desc: '雾霭山色' },
  { id: 'noon', name: '正午', desc: '阳光沙滩' },
  { id: 'dusk', name: '傍晚', desc: '落日晚霞' },
  { id: 'exotic', name: '异国风情', desc: '北欧牧场' },
];
---

<div class="fixed left-3 top-3 z-50" id="theme-switcher">
  <button
    id="theme-toggle"
    class="ts-btn"
    aria-label="切换主题"
    aria-expanded="false"
    title="切换主题"
  >
    <!-- 黑夜：月亮 -->
    <svg class="ts-icon ts-icon-dark" width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M20 13.5A8.5 8.5 0 0 1 10.5 4a8.5 8.5 0 1 0 9.5 9.5Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
    <!-- 白天：太阳 -->
    <svg class="ts-icon ts-icon-light" width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m9.4 9.4 1.4 1.4m0-14.2-1.4 1.4M6.3 15.7l-1.4 1.4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    <!-- 早晨：日出 -->
    <svg class="ts-icon ts-icon-morning" width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 18h16M7 15a5 5 0 0 1 10 0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M12 4v3M5.6 6.6l1.8 1.8M18.4 6.6l-1.8 1.8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    <!-- 正午：烈日 -->
    <svg class="ts-icon ts-icon-noon" width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="9" r="4" fill="currentColor"/><path d="M12 1v2M12 15v2M4 9H2m20 0h-2M5.6 4.6l1.4 1.4M17 16l1.4 1.4M18.4 4.6 17 6M7 16l-1.4 1.4M3 21c2-1.5 4-1.5 6 0s4 1.5 6 0 4-1.5 6 0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    <!-- 傍晚：日落 -->
    <svg class="ts-icon ts-icon-dusk" width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 16h16M7 13a5 5 0 0 1 10 0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M12 19v3m0-3 2 2m-2-2-2 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <!-- 异国风情：风车 -->
    <svg class="ts-icon ts-icon-exotic" width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 12 12 3M12 12l7.8 4.5M12 12l-7.8 4.5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/><circle cx="12" cy="12" r="1.6" fill="currentColor"/><path d="M9.5 14 8 22h8l-1.5-8" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
  </button>

  <!-- 主题卡片列表 -->
  <div id="theme-menu" class="ts-menu" aria-label="主题列表">
    {
      themes.map((t) => (
        <button class="ts-item" data-set-theme={t.id} data-theme-id={t.id}>
          <span class={`ts-item-icon ts-ic-${t.id}`}>
            {t.id === 'dark' && <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M20 13.5A8.5 8.5 0 0 1 10.5 4a8.5 8.5 0 1 0 9.5 9.5Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>}
            {t.id === 'light' && <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m9.4 9.4 1.4 1.4m0-14.2-1.4 1.4M6.3 15.7l-1.4 1.4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>}
            {t.id === 'morning' && <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M4 18h16M7 15a5 5 0 0 1 10 0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M12 4v3M5.6 6.6l1.8 1.8M18.4 6.6l-1.8 1.8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>}
            {t.id === 'noon' && <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="9" r="4" fill="currentColor"/><path d="M12 1v2M12 15v2M4 9H2m20 0h-2M5.6 4.6l1.4 1.4M17 16l1.4 1.4M18.4 4.6 17 6M7 16l-1.4 1.4M3 21c2-1.5 4-1.5 6 0s4 1.5 6 0 4-1.5 6 0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>}
            {t.id === 'dusk' && <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M4 16h16M7 13a5 5 0 0 1 10 0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M12 19v3m0-3 2 2m-2-2-2 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>}
            {t.id === 'exotic' && <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 12 12 3M12 12l7.8 4.5M12 12l-7.8 4.5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/><circle cx="12" cy="12" r="1.6" fill="currentColor"/><path d="M9.5 14 8 22h8l-1.5-8" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>}
          </span>
          <span class="ts-item-text">
            <span class="ts-item-name">{t.name}</span>
            <span class="ts-item-desc">{t.desc}</span>
          </span>
          <span class="ts-check" aria-hidden="true">✓</span>
        </button>
      ))
    }
  </div>
</div>

<style is:global>
  /* 触发按钮 */
  .ts-btn {
    display: flex;
    height: 2.75rem;
    width: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid var(--c-card-border);
    background: var(--c-card-bg);
    color: var(--c-text-muted);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: all 0.3s ease;
    cursor: pointer;
  }
  .ts-btn:hover {
    color: var(--c-accent);
    border-color: var(--c-accent);
    transform: rotate(12deg);
  }

  /* 按钮图标：只显示当前主题的 */
  .ts-icon {
    display: none;
  }
  .ts-icon-dark { color: #a5b4fc; }
  .ts-icon-light { color: #f59e0b; }
  .ts-icon-morning { color: #0f766e; }
  .ts-icon-noon { color: #ea580c; }
  .ts-icon-dusk { color: #fb923c; }
  .ts-icon-exotic { color: #15803d; }
  [data-theme="dark"] .ts-icon-dark,
  [data-theme="light"] .ts-icon-light,
  [data-theme="morning"] .ts-icon-morning,
  [data-theme="noon"] .ts-icon-noon,
  [data-theme="dusk"] .ts-icon-dusk,
  [data-theme="exotic"] .ts-icon-exotic {
    display: block;
  }

  /* 卡片列表 */
  .ts-menu {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    width: 13.5rem;
    padding: 0.5rem;
    border-radius: 1rem;
    border: 1px solid var(--c-card-border);
    background: var(--c-card-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
    opacity: 0;
    transform: translateY(-8px) scale(0.96);
    transform-origin: top left;
    pointer-events: none;
    transition:
      opacity 0.25s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ts-menu.open {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .ts-item {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.6rem;
    border-radius: 0.65rem;
    color: var(--c-text);
    cursor: pointer;
    transition: background 0.2s ease;
    text-align: left;
  }
  .ts-item:hover {
    background: rgba(127, 127, 127, 0.15);
  }
  .ts-item-icon {
    display: flex;
    height: 2rem;
    width: 2rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    background: rgba(127, 127, 127, 0.12);
  }
  .ts-ic-dark { color: #a5b4fc; }
  .ts-ic-light { color: #f59e0b; }
  .ts-ic-morning { color: #0f766e; }
  .ts-ic-noon { color: #ea580c; }
  .ts-ic-dusk { color: #fb923c; }
  .ts-ic-exotic { color: #15803d; }

  .ts-item-text {
    display: flex;
    flex: 1;
    flex-direction: column;
    line-height: 1.3;
  }
  .ts-item-name {
    font-size: 0.85rem;
    font-weight: 600;
  }
  .ts-item-desc {
    font-size: 0.68rem;
    color: var(--c-text-muted);
  }
  .ts-check {
    font-size: 0.8rem;
    color: var(--c-accent);
    opacity: 0;
    transition: opacity 0.2s;
  }
  .ts-item.active .ts-check {
    opacity: 1;
  }
  .ts-item.active {
    background: rgba(127, 127, 127, 0.12);
  }
</style>

<script>
  const root = document.documentElement;
  const switcher = document.getElementById('theme-switcher')!;
  const btn = document.getElementById('theme-toggle')!;
  const menu = document.getElementById('theme-menu')!;
  const items = [...menu.querySelectorAll<HTMLElement>('[data-set-theme]')];

  const syncActive = () => {
    const cur = root.dataset.theme ?? 'dark';
    items.forEach((el) => el.classList.toggle('active', el.dataset.setTheme === cur));
  };

  const openMenu = (open: boolean) => {
    menu.classList.toggle('open', open);
    btn.setAttribute('aria-expanded', String(open));
  };

  btn.addEventListener('click', (e) => {
    e.stopPropagation();
    openMenu(!menu.classList.contains('open'));
  });

  items.forEach((el) => {
    el.addEventListener('click', () => {
      const t = el.dataset.setTheme!;
      root.dataset.theme = t;
      localStorage.setItem('theme', t);
      window.dispatchEvent(new CustomEvent('theme-change', { detail: t }));
      syncActive();
      openMenu(false);
    });
  });

  // 点击组件外部或按 Esc 关闭
  document.addEventListener('click', (e) => {
    if (!switcher.contains(e.target as Node)) openMenu(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') openMenu(false);
  });

  syncActive();
</script>
