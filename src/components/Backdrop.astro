    <div class="bd-cloud noon-cloud-1"></div>
    <div class="bd-cloud noon-cloud-2"></div>
  </div>

  <!-- ============ 傍晚：落日晚霞（照片） ============ -->
  <div class="bd bd-dusk">
    <img class="bd-photo" src="/images/themes/dusk.jpg" alt="" loading="eager" />
    <div class="bd-photo-overlay"></div>
    <!-- 高处疏星闪烁 + 暖色光斑呼吸 -->
    <div class="bd-dusk-stars"><i></i><i></i><i></i><i></i><i></i></div>
    <div class="dusk-glow"></div>
  </div>

  <!-- ============ 异国风情：北欧牧场（照片） ============ -->
  <div class="bd bd-exotic">
    <img class="bd-photo" src="/images/themes/exotic.jpg" alt="" loading="eager" />
    <div class="bd-photo-overlay"></div>
    <!-- 白云漂移 -->
    <div class="bd-cloud ex-cloud-1"></div>
    <div class="bd-cloud ex-cloud-2"></div>
  </div>
</div>

<style is:global>
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }
  .bd {
    position: absolute;
    inset: 0;
    display: none;
    overflow: hidden;
  }
  [data-theme="morning"] .bd-morning,
  [data-theme="noon"] .bd-noon,
  [data-theme="dusk"] .bd-dusk,
  [data-theme="exotic"] .bd-exotic {
    display: block;
  }

  /* 写实照片：全屏铺满 + 缓慢缩放的"呼吸感" */
  .bd-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: bd-breathe 34s ease-in-out infinite alternate;
  }
  /* 浅色系主题文字为深色：用白纱罩提亮照片、统一背景，保证对比度 */
  .bd-photo-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(255, 255, 252, 0.5) 0%, rgba(255, 255, 252, 0.28) 35%, rgba(255, 255, 252, 0.3) 65%, rgba(255, 255, 252, 0.52) 100%);
  }
  /* 傍晚文字为浅色：改用暗罩压暗，突出晚霞 */
  [data-theme="dusk"] .bd-photo-overlay {
    background:
      linear-gradient(180deg, rgba(26, 12, 30, 0.42) 0%, rgba(26, 12, 30, 0.1) 40%, rgba(20, 8, 24, 0.32) 100%);
  }

  /* ---------- 早晨 ---------- */
  .bd-fog {
    position: absolute;
    border-radius: 9999px;
    filter: blur(46px);
    background: rgba(255, 255, 255, 0.5);
    animation: bd-drift 24s ease-in-out infinite alternate;
  }
  .m-fog-1 { width: 55vw; height: 130px; bottom: 22%; left: -8%; }
  .m-fog-2 { width: 45vw; height: 110px; bottom: 38%; right: -10%; animation-delay: -9s; animation-duration: 30s; }

  .bd-dew {
    position: absolute;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.95), rgba(190, 225, 255, 0.4) 60%, transparent 72%);
    animation: bd-twinkle 3.2s ease-in-out infinite;
  }

  /* ---------- 正午 ---------- */
  .bd-cloud {
    position: absolute;
    border-radius: 9999px;
    filter: blur(24px);
    background: rgba(255, 255, 255, 0.55);
    animation: bd-cloud-move 80s linear infinite;
  }
  .noon-cloud-1 { width: 240px; height: 60px; top: 12%; left: 12%; }
  .noon-cloud-2 { width: 320px; height: 70px; top: 24%; left: 55%; animation-duration: 105s; animation-delay: -40s; }

  /* ---------- 傍晚 ---------- */
  .bd-dusk-stars i {
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #fff;
    animation: bd-twinkle 2.6s ease-in-out infinite;
  }
  .bd-dusk-stars i:nth-child(1) { top: 8%; left: 15%; }
  .bd-dusk-stars i:nth-child(2) { top: 5%; left: 38%; animation-delay: 0.8s; }
  .bd-dusk-stars i:nth-child(3) { top: 12%; left: 62%; animation-delay: 1.4s; }
  .bd-dusk-stars i:nth-child(4) { top: 6%; left: 80%; animation-delay: 0.4s; }
  .bd-dusk-stars i:nth-child(5) { top: 15%; left: 92%; animation-delay: 1.9s; }
  /* 落日暖光呼吸 */
  .dusk-glow {
    position: absolute;
    left: 50%;
    bottom: 10%;
    width: 46vw;
    height: 46vw;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(251, 146, 60, 0.22), transparent 65%);
    animation: bd-glow-pulse 7s ease-in-out infinite;
  }

  /* ---------- 异国风情 ---------- */
  .ex-cloud-1 { width: 260px; height: 60px; top: 10%; left: 20%; }
  .ex-cloud-2 { width: 320px; height: 66px; top: 22%; left: 65%; animation-duration: 100s; animation-delay: -30s; }

  /* ---------- 关键帧 ---------- */
  @keyframes bd-breathe {
    from { transform: scale(1); }
    to { transform: scale(1.06); }
  }
  @keyframes bd-drift {
    from { transform: translateX(-4vw); }
    to { transform: translateX(4vw); }
  }
  @keyframes bd-twinkle {
    0%, 100% { opacity: 0.2; transform: scale(0.8); }
    50% { opacity: 1; transform: scale(1.15); }
  }
  @keyframes bd-cloud-move {
    from { transform: translateX(-30vw); }
    to { transform: translateX(130vw); }
  }
  @keyframes bd-girl-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  @keyframes bd-glow-pulse {
    0%, 100% { opacity: 0.5; transform: translateX(-50%) scale(1); }
    50% { opacity: 1; transform: translateX(-50%) scale(1.12); }
  }

  @media (prefers-reduced-motion: reduce) {
    .bd *,
    .bd *::before,
    .bd *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>
