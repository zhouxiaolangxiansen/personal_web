<!-- 写实主题背景：AI 生成的风景照 + 轻量动效 -->
<div class="backdrop" aria-hidden="true">

  <!-- ============ 早晨：雾霭山谷（照片） ============ -->
  <div class="bd bd-morning">
    <img class="bd-photo" src="/images/themes/morning.jpg" alt="" loading="eager" />
    <div class="bd-photo-overlay"></div>
    <!-- 漂移薄雾 + 露珠微光 -->
    <div class="bd-fog m-fog-1"></div>
    <div class="bd-fog m-fog-2"></div>
    <i class="bd-dew" style="top:30%;left:12%"></i>
    <i class="bd-dew" style="top:55%;left:28%;animation-delay:1.2s"></i>
    <i class="bd-dew" style="top:42%;left:55%;animation-delay:0.6s"></i>
    <i class="bd-dew" style="top:63%;left:72%;animation-delay:1.8s"></i>
    <i class="bd-dew" style="top:35%;left:86%;animation-delay:0.3s"></i>
  </div>

  <!-- ============ 正午：阳光沙滩（照片：少女与少年追逐打闹） ============ -->
  <div class="bd bd-noon">
    <img class="bd-photo" src="/images/themes/noon.jpg" alt="" loading="eager" />
