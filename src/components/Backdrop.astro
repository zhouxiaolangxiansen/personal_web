<!-- 四套主题的场景装饰层：CSS 按 data-theme 控制显隐 -->
<div class="backdrop" aria-hidden="true">

  <!-- ============ 早晨：雾霭山色 ============ -->
  <div class="bd bd-morning">
    <div class="bd-morning-sun"></div>
    <div class="bd-fog m-fog-1"></div>
    <div class="bd-fog m-fog-2"></div>
    <div class="bd-fog m-fog-3"></div>
    <svg class="bd-mountains" viewBox="0 0 1440 320" preserveAspectRatio="none">
      <path d="M0,220 L180,120 L320,190 L520,80 L700,180 L900,110 L1100,200 L1300,130 L1440,190 L1440,320 L0,320 Z" fill="#9ec9b4" opacity="0.5"/>
      <path d="M0,260 L240,180 L430,240 L640,160 L860,240 L1080,180 L1280,250 L1440,210 L1440,320 L0,320 Z" fill="#7fb69e" opacity="0.65"/>
